{
  "name": "SERK AURA",
  "version": "0.1.0",
  "status": "DESIGNED: specification only. The console does not use these tokens yet.",
  "themes": {
    "light": {
      "color": {
        "primary": "#103E32", "primary-hover": "#185746", "on-primary": "#FFFFFF", "accent-soft": "#DFF3E9",
        "canvas": "#F7F9F8", "surface": "#FFFFFF",
        "text": "#14201C", "text-secondary": "#52635D",
        "border": "#E0E7E3", "border-control": "#7C8C86", "focus": "#175CD3",
        "success": "#16794A", "warning": "#946000", "danger": "#B42318", "info": "#175CD3"
      }
    }
  },
  "contrast_pairs": [
    ["text", "surface", 4.5, "body text on cards and tables"],
    ["text", "canvas", 4.5, "body text on the page"],
    ["text-secondary", "surface", 4.5, "secondary text, hints, table headers"],
    ["text-secondary", "canvas", 4.5, "secondary text on the page"],
    ["text", "accent-soft", 4.5, "text on selected rows and soft highlights"],
    ["primary", "accent-soft", 4.5, "primary-coloured text on a soft highlight"],
    ["on-primary", "primary", 4.5, "primary button label"],
    ["on-primary", "primary-hover", 4.5, "primary button label, hover"],
    ["primary", "surface", 4.5, "links and primary text on a card"],
    ["success", "surface", 4.5, "success text"],
    ["warning", "surface", 4.5, "warning text"],
    ["danger", "surface", 4.5, "error text"],
    ["info", "surface", 4.5, "information text and links"],
    ["on-primary", "danger", 4.5, "destructive button label"],
    ["focus", "surface", 3.0, "focus ring against a card"],
    ["focus", "canvas", 3.0, "focus ring against the page"],
    ["border-control", "surface", 3.0, "input and checkbox boundary (a control must be distinguishable)"],
    ["border", "surface", 1.0, "decorative divider only (no requirement). At 1.26:1 it must never be the only boundary of an input, checkbox or button: use border-control"]
  ],
  "typography": {
    "family": {"interface": "Inter, 'Noto Sans Ethiopic', system-ui, sans-serif", "ethiopic": "'Noto Sans Ethiopic', sans-serif", "mono": "'IBM Plex Mono', ui-monospace, monospace"},
    "numeric": "font-variant-numeric: tabular-nums for every amount, quantity and meter reading",
    "scale_px": {"caption": 12, "body": 14, "body-large": 16, "title": 18, "heading": 22, "display": 28},
    "line_height": {"dense": 1.35, "normal": 1.5}
  },
  "space_px": [2, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius_px": {"control": 6, "card": 10, "sheet": 14},
  "elevation": {"flat": "none", "raised": "0 1px 2px rgba(20,32,28,.06)", "overlay": "0 8px 24px rgba(20,32,28,.12)"},
  "motion_ms": {"feedback": 120, "component": 200, "panel": 260, "reduced": 0},
  "touch_target_px": 44,
  "breakpoints_px": {"phone": 360, "phone-large": 430, "tablet": 768, "laptop": 1280, "desktop": 1440, "wide": 1920}
}
